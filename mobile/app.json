{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",

    "ios": {},

    "android": {
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static"
    },

    "plugins": ["expo-router", "expo-secure-store"],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
